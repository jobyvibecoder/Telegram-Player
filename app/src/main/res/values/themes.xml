<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Leanback Theme for TV browse screens -->
    <style name="Theme.TelegramPlayer" parent="Theme.Leanback">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="defaultBrandColor">@color/primary</item>
        <item name="defaultBrandColorDark">@color/primary_dark</item>
        
        <!-- Customize Leanback colors -->
        <item name="defaultSearchColor">@color/primary</item>
        <item name="defaultSearchIconColor">@color/text_primary</item>
        <item name="defaultSearchBrightColor">@color/primary_light</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- AppCompat Theme for AuthActivity (required for AppCompatActivity) -->
    <style name="Theme.TelegramPlayer.Auth" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- GuidedStep Theme for Settings Activity -->
    <style name="Theme.TelegramPlayer.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
